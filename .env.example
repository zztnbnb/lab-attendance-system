# 基础运行模式：生产环境务必修改所有 dev-only 和默认值
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://labtime:change-database-password@db:5432/labtime
AUTO_CREATE_TABLES=false

# 认证与 Cookie
JWT_SECRET=dev-only-change-this-jwt-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=https://labtime.example.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_REAL_NAME=系统管理员

# 使用 `openssl rand -base64 32` 生成；密钥必须独立于数据库备份保存
EMBEDDING_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
KEY_VERSION=1
DEVICE_CREDENTIAL_PEPPER=dev-only-change-device-pepper

# 人脸模型与阈值。SHA-256 以下载后实际文件计算并固定
FACE_ENGINE=opencv
REQUIRE_FACE_ENGINE=true
YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=/models/face_recognition_sface_2021dec.onnx
YUNET_MODEL_SHA256=
SFACE_MODEL_SHA256=
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
MIN_FACE_TEMPLATES=3

# 一期仅预留静默活体模型门槛；正式试运行前必须完成目标摄像头标定
REQUIRE_PASSIVE_LIVENESS=false
PASSIVE_LIVENESS_MODEL_PATH=
MISSING_CHECKOUT_HOURS=24
TIMEZONE=Asia/Shanghai

# PostgreSQL 容器
POSTGRES_DB=labtime
POSTGRES_USER=labtime
POSTGRES_PASSWORD=change-database-password
